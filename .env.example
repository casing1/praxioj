# Native development settings. Export these in your shell; the API does not
# implicitly read .env. Docker Compose also reads an optional root .env for provider settings.
# These database credentials are public development defaults, never secrets.
DATABASE_URL=postgresql+psycopg://praxioj:praxioj@127.0.0.1:5432/praxioj
PRAXIOJ_ENV=development
# Mock is the default. Compatible-provider settings are server-side only.
# Leave these blank to run without credentials or any outbound provider calls.
PRAXIOJ_DEFAULT_PROFILE=mock
PRAXIOJ_LLM_BASE_URL=
PRAXIOJ_LLM_MODEL=
PRAXIOJ_LLM_API_KEY=
# Advertise only capabilities supported by the configured endpoint/model.
PRAXIOJ_LLM_SUPPORTS_TOOLS=false
PRAXIOJ_LLM_SUPPORTS_SYSTEM=true
PRAXIOJ_LLM_SUPPORTS_TEMPERATURE=true
PRAXIOJ_LLM_TOKEN_PARAMETER=max_tokens
PRAXIOJ_LLM_TIMEOUT_SECONDS=30
# Optional estimates per one million tokens. Blank means no cost estimate.
PRAXIOJ_PRICE_INPUT_PER_MILLION=
PRAXIOJ_PRICE_OUTPUT_PER_MILLION=
PRAXIOJ_PRICE_CURRENCY=USD
