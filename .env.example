# Native development settings. Export these in your shell; the API does not
# implicitly read .env. Docker Compose also reads an optional root .env for provider settings.
# These database credentials are public development defaults, never secrets.
DATABASE_URL=postgresql+psycopg://praxioj:praxioj@127.0.0.1:5432/praxioj
PRAXIOJ_ENV=development
# Mock is the default. Compatible-provider settings are server-side only.
# Leave these blank to run without credentials or any outbound provider calls.
PRAXIOJ_DEFAULT_PROFILE=mock
PRAXIOJ_LLM_BASE_URL=
PRAXIOJ_LLM_MODEL=
PRAXIOJ_LLM_API_KEY=
# Advertise only capabilities supported by the configured endpoint/model.
PRAXIOJ_LLM_SUPPORTS_TOOLS=false
PRAXIOJ_LLM_SUPPORTS_SYSTEM=true
PRAXIOJ_LLM_SUPPORTS_TEMPERATURE=true
PRAXIOJ_LLM_TOKEN_PARAMETER=max_tokens
PRAXIOJ_LLM_TIMEOUT_SECONDS=30
# Optional estimates per one million tokens. Blank means no cost estimate.
PRAXIOJ_PRICE_INPUT_PER_MILLION=
PRAXIOJ_PRICE_OUTPUT_PER_MILLION=
PRAXIOJ_PRICE_CURRENCY=USD
# M3 authentication/retention. No administrator account or password is supplied.
PRAXIOJ_COOKIE_SECURE=false
PRAXIOJ_AUTH_SESSION_SECONDS=28800
PRAXIOJ_TRACE_RETENTION_DAYS=30
PRAXIOJ_TRACE_RETENTION_MAX_DAYS=90
PRAXIOJ_AUDIT_RETENTION_DAYS=90
# Native worker timing (seconds); defaults also apply to the Compose worker.
PRAXIOJ_WORKER_LEASE_SECONDS=15
PRAXIOJ_WORKER_HEARTBEAT_SECONDS=3
PRAXIOJ_WORKER_POLL_SECONDS=0.5
# M4 bounded admission, session confirmation, and operational budgets.
# Token reservations are policy units, not provider billing measurements.
PRAXIOJ_AUTH_MAX_SESSIONS=5
PRAXIOJ_AUTH_REAUTHENTICATION_SECONDS=300
PRAXIOJ_AUTH_RATE_WINDOW_SECONDS=300
PRAXIOJ_AUTH_IP_LIMIT=30
PRAXIOJ_AUTH_ACCOUNT_LIMIT=10
PRAXIOJ_API_IP_LIMIT=600
PRAXIOJ_API_RATE_WINDOW_SECONDS=60
PRAXIOJ_ACCOUNT_ACTIVE_SESSIONS=10
PRAXIOJ_ACCOUNT_RETAINED_SESSIONS=100
PRAXIOJ_SYSTEM_RETAINED_SESSIONS=10000
PRAXIOJ_ACCOUNT_ACTIVE_RUNS=2
PRAXIOJ_QUEUE_MAX_PENDING=100
PRAXIOJ_WORKER_MAX_RUNNING=4
PRAXIOJ_WORKER_SHUTDOWN_SECONDS=5
PRAXIOJ_ACCOUNT_DAILY_MODEL_CALLS=200
PRAXIOJ_PROBLEM_DAILY_MODEL_CALLS=2000
PRAXIOJ_SYSTEM_DAILY_MODEL_CALLS=10000
PRAXIOJ_ACCOUNT_DAILY_TOOL_CALLS=400
PRAXIOJ_PROBLEM_DAILY_TOOL_CALLS=4000
PRAXIOJ_SYSTEM_DAILY_TOOL_CALLS=20000
PRAXIOJ_ACCOUNT_DAILY_TOKEN_ALLOWANCE=2000000
PRAXIOJ_PROBLEM_DAILY_TOKEN_ALLOWANCE=20000000
PRAXIOJ_SYSTEM_DAILY_TOKEN_ALLOWANCE=100000000
PRAXIOJ_CALL_TOKEN_RESERVATION=16384
PRAXIOJ_SESSION_ARTIFACT_MAX_BYTES=1048576
PRAXIOJ_SESSION_TRACE_MAX_BYTES=8388608
PRAXIOJ_SESSION_TRACE_MAX_EVENTS=2000
PRAXIOJ_ACCOUNT_ARTIFACT_CAPACITY_BYTES=16777216
PRAXIOJ_SYSTEM_ARTIFACT_CAPACITY_BYTES=268435456
PRAXIOJ_ACCOUNT_TRACE_CAPACITY_BYTES=268435456
PRAXIOJ_SYSTEM_TRACE_CAPACITY_BYTES=2147483648
PRAXIOJ_EXPORT_MAX_BYTES=16777216
PRAXIOJ_EXPORT_MAX_ROWS=10000
